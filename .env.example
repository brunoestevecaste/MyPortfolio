# Server-only key. Create it in a FREE Groq account; never use NEXT_PUBLIC_.
GROQ_API_KEY=

# Required in production. Leave empty in local development.
# single-instance: ONE persistent Node process (not serverless / not Vercel).
# edge: configure a real distributed rate limit at the hosting firewall FIRST.
CHAT_PROTECTION_MODE=

# Production canonical origin, e.g. https://your-portfolio.example
# Include scheme; no path. Configure per preview deployment when necessary.
CHAT_ALLOWED_ORIGIN=

# Self-hosted reverse proxy only: it MUST overwrite this header, and the Node
# server MUST be inaccessible directly. Vercel uses its own trusted header.
# Without a trusted proxy, all visitors share a conservative global budget.
CHAT_TRUSTED_IP_HEADER=
