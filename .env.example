# Generative AI is the default. Optional "local" is a non-generative fallback.
CHAT_MODE=groq

# Server-only Groq Free Plan key. Put the REAL value ONLY in .env.local or
# your hosting environment manager. NEVER use NEXT_PUBLIC_ for a secret.
GROQ_API_KEY=

# Required in production; leave blank for npm run dev.
# Example: https://your-project.vercel.app (no path, query or fragment).
CHAT_ALLOWED_ORIGIN=

# Production only. Vercel: configure and PUBLISH a WAF rate limit first,
# then set edge. This variable does not create or verify the firewall rule.
# single-instance is only for ONE persistent Node process, never Vercel.
CHAT_PROTECTION_MODE=

# Leave empty on Vercel and localhost. Only for a trusted reverse proxy that
# overwrites this header and prevents direct access to the Node server.
CHAT_TRUSTED_IP_HEADER=
